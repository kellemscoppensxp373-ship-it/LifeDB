{
  "name": "life-dashboard",
  "private": true,
  "version": "1.0.0",
  "description": "Life Dashboard — Y2K Cyber-Gothic Glassmorphism desktop HUD. Electron + React + Vite + Tailwind + Framer Motion + React Three Fiber.",
  "author": "LifeDB",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "electron:dev": "concurrently -k \"vite --host 0.0.0.0 --port 5173\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:preview": "vite build && electron .",
    "dist": "vite build && electron-builder",
    "setup:ai": "pip install -r local_ai_service/requirements.txt",
    "ai:serve": "python local_ai_service/app.py"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "electron": "^33.2.0",
    "framer-motion": "^11.13.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwindcss": "^3.4.14",
    "three": "^0.169.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "vite": "^5.4.11",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.lifedb.dashboard",
    "productName": "LifeDashboard",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"]
    },
    "mac": {
      "target": ["dmg"]
    }
  }
}
